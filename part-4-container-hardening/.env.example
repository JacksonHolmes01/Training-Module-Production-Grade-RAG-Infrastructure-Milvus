# Copied to .env by bin/setup_secrets.sh, which also generates EDGE_API_KEY.
# .env is ignored by git. Never commit it.

# Which compose files are active. bin/harden.sh adds a hardening layer each lesson.
COMPOSE_FILE=docker-compose.yml

EDGE_API_KEY=

# Which tenant this deployment serves (each tenant gets its own Milvus database)
APP_TENANT=lab

OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

RAG_TOP_K=4
RAG_MAX_SOURCE_CHARS=1200
GRADIO_HTTP_TIMEOUT_S=600

# Debug endpoints show prompts and raw retrieval. Turn off outside the lab.
ENABLE_DEBUG_ENDPOINTS=true

# 0 = the same question always gets the same answer (repeatable experiments)
OLLAMA_TEMPERATURE=0

# ---- Prompt injection defenses (Part 3) ----
# All on from Part 3. bin/guard.sh still works if you want to experiment.
GUARD_INPUT=true
GUARD_INGEST=true
GUARD_PROMPT=true
# Part of the prompt guard. false = test the hardened wording on its own
PROMPT_SANITIZE=true
GUARD_OUTPUT=true
# Links to these domains (and their subdomains) survive the output filter
ALLOWED_LINK_DOMAINS=example.org
